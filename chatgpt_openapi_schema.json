{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenFinder - Universal AI Job Catcher for Freshers & Experienced API",
    "description": "High-precision LinkedIn hiring post finder, candidate resume profile extractor, and recruiter outreach suite for ChatGPT Custom GPTs. Discovers verified /posts/ URLs with exact minute-level freshness and ATS candidate fit scoring for freshers and experienced candidates.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://openfinder.onrender.com"
    }
  ],
  "paths": {
    "/api/create-candidate-profile": {
      "post": {
        "summary": "Create or Save Candidate Profile from Resume Data",
        "description": "Creates a persistent candidate profile from extracted resume text or skills, returning a unique candidate_profile_id.",
        "operationId": "createCandidateProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "candidate_name": {
                    "type": "string",
                    "description": "Candidate full name"
                  },
                  "skills": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of core technical skills (e.g. ['React.js', 'Node.js', 'Express.js', 'MongoDB', 'JavaScript'])"
                  },
                  "years_of_experience": {
                    "type": "integer",
                    "description": "Total years of experience (e.g. 1)"
                  },
                  "primary_role": {
                    "type": "string",
                    "description": "Target job title (e.g. 'MERN Stack Engineer')"
                  },
                  "target_roles": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["skills"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "candidate_profile_id": { "type": "string" },
                    "candidate_name": { "type": "string" },
                    "seniority_level": { "type": "string" },
                    "years_of_experience": { "type": "integer" },
                    "primary_role": { "type": "string" },
                    "top_skills": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/search-opportunities": {
      "get": {
        "summary": "Search Verified LinkedIn Recruiter Hiring Opportunities",
        "description": "Canonical search operation. Discovers verified genuine LinkedIn hiring /posts/ with exact freshness filters, directional hiring intent, and opportunity ranking against candidate profile or inline skills.",
        "operationId": "searchOpportunities",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "React Developer"
            },
            "description": "Job role or technical skill keywords (e.g. 'MERN Stack Developer', 'React Developer', 'Python Backend')"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "India"
            },
            "description": "City or Region (e.g. 'Chennai', 'Bangalore', 'Remote', 'India')"
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "past-24h",
              "enum": ["past-1h", "past-4h", "past-12h", "past-24h", "past-7d"]
            },
            "description": "Exact freshness window: 'past-1h' (last 1 hr), 'past-4h', 'past-12h', 'past-24h', 'past-7d'"
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5
            },
            "description": "Max opportunities to return (1-30)"
          },
          {
            "name": "remote_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Filter for remote roles only"
          },
          {
            "name": "candidate_profile_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional stored candidate profile ID (e.g. 'prof_d0fbb15d5b15')"
          },
          {
            "name": "candidate_skills",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional comma-separated skills for instant ATS matching (e.g. 'React, Node.js, Express, MongoDB, JavaScript')"
          },
          {
            "name": "candidate_exp_years",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Candidate total years of experience (e.g. 1)"
          },
          {
            "name": "candidate_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Candidate full name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of ranked verified hiring posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "query": { "type": "string" },
                    "location": { "type": "string" },
                    "timeframe": { "type": "string" },
                    "count": { "type": "integer" },
                    "candidate_profile_id": { "type": "string" },
                    "candidate_name": { "type": "string" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "company": { "type": "string" },
                          "role": { "type": "string" },
                          "author": { "type": "string" },
                          "author_type": { "type": "string" },
                          "location": { "type": "string" },
                          "posted_time": { "type": "string" },
                          "hiring_intent": { "type": "string" },
                          "post_quality_score": { "type": "integer" },
                          "candidate_match_score": { "type": "integer", "nullable": true },
                          "final_rank_score": { "type": "integer" },
                          "ranking_summary": { "type": "string" },
                          "ranking_reasons": { "type": "array", "items": { "type": "string" } },
                          "recruiter_emails": { "type": "array", "items": { "type": "string" } },
                          "skills": { "type": "array", "items": { "type": "string" } },
                          "matched_skills": { "type": "array", "items": { "type": "string" } },
                          "post_url": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/candidate-profile/{profile_id}": {
      "get": {
        "summary": "Retrieve Stored Candidate Profile",
        "description": "Retrieves structured candidate skills, experience, and target roles using a candidate_profile_id.",
        "operationId": "getCandidateProfile",
        "parameters": [
          {
            "name": "profile_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique candidate profile ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate profile details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "candidate_profile": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/generate-pitch": {
      "post": {
        "summary": "Generate Customized Recruiter Outreach Pitch Suite",
        "description": "Generates 4 personalized recruiter outreach templates (LinkedIn Connection Note <300 chars, InMail, Formal Cover Email, Day-3 Follow-up).",
        "operationId": "generatePitch",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "job_title": {
                    "type": "string",
                    "description": "Target job title (e.g. 'React Developer')"
                  },
                  "company_name": {
                    "type": "string",
                    "default": "Hiring Team",
                    "description": "Target hiring company"
                  },
                  "matched_skills": {
                    "type": "string",
                    "default": "React, TypeScript",
                    "description": "Comma-separated matched technical skills"
                  },
                  "candidate_name": {
                    "type": "string",
                    "default": "Candidate",
                    "description": "Candidate name for sign-off"
                  },
                  "candidate_exp_years": {
                    "type": "integer",
                    "default": 2,
                    "description": "Candidate total years of experience"
                  }
                },
                "required": ["job_title"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Outreach pitch suite generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
